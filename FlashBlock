    btnStroke.Thickness = 2
    btnStroke.Transparency = 0.2
    
    -- Estado
    local allowed = false
    local cooldown = false
    
    -- Função para obter os plots do jogador
    local function getMyPlot()
        local myPlots = {}
        local myName = LocalPlayer.DisplayName
        local plots = Workspace:FindFirstChild("Plots")
        if not plots then return myPlots end
        
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            local label = sign and sign:FindFirstChild("SurfaceGui") 
                and sign.SurfaceGui:FindFirstChild("Frame") 
                and sign.SurfaceGui.Frame:FindFirstChild("TextLabel")
            
            if label then
                local owner = label.Text:gsub("'s Base$", ""):gsub("'s base$", ""):gsub("%s+$", "")
                if owner == myName then
                    table.insert(myPlots, plot)
                end
            end
        end
        return myPlots
    end
    
    -- Função para atualizar a UI do botão
    local function updateButtonUI(state)
        allowed = state
        if allowed then
            btn.Text = "ALLOW"
            btn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
            btnStroke.Color = Color3.fromRGB(34, 197, 94)
            btn.TextColor3 = C.white
            frame.BackgroundColor3 = C.body
        else
            btn.Text = "DISALLOW"
            btn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
            btnStroke.Color = Color3.fromRGB(255, 60, 60)
            btn.TextColor3 = C.white
            frame.BackgroundColor3 = C.body
        end
    end
    
    -- Função para alternar o estado
    local function toggleAllowDisallow()
        if cooldown then return end
        cooldown = true
        
        local myPlots = getMyPlot()
        for _, plot in ipairs(myPlots) do
            local prompt = plot:FindFirstChild("FriendPanel") 
                and plot.FriendPanel:FindFirstChild("Main") 
                and plot.FriendPanel.Main:FindFirstChild("ProximityPrompt")
            
            if prompt then
                fireproximityprompt(prompt)
                updateButtonUI(not allowed)
            end
        end
        
        task.wait(1)
        cooldown = false
    end
    
    btn.MouseButton1Click:Connect(toggleAllowDisallow)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            toggleAllowDisallow()
        end
    end)
    
    -- Inicializa como DISALLOW
    updateButtonUI(false)
    
    return frame
end

