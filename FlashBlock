local WALL_PLANE_DEPTH = 2.5
local WALL_SIDE_MARGIN = 1.5

local _wallCache = {}
for _, wall in ipairs(BALLOON_WALLS) do
    local rad = math.rad(wall.rot)
    table.insert(_wallCache, {
        px = wall.pos.X, py = wall.pos.Y, pz = wall.pos.Z,
        nx =  math.cos(rad), nz = -math.sin(rad),
        ax =  math.sin(rad), az =  math.cos(rad),
        halfW = wall.w / 2,
        halfH = wall.h / 2,
    })
end

local function isNearAnyWall(pos)
    for _, w in ipairs(_wallCache) do
        local dx    = pos.X - w.px
        local dz    = pos.Z - w.pz
        local depth = dx * w.nx + dz * w.nz
        if math.abs(depth) > WALL_PLANE_DEPTH then continue end
        local side  = dx * w.ax + dz * w.az
        if math.abs(side) > w.halfW + WALL_SIDE_MARGIN then continue end
        return true
    end
    return false
end

