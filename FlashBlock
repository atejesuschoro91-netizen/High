    if not antiRagdollEnabled then return end
    for _, conn in pairs(AntiRagdollConns) do pcall(function() conn:Disconnect() end) end
    AntiRagdollConns = {}
    task.spawn(function() connectAntiRagdollToChar(newChar) end)
end))

