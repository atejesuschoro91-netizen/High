                local val = lp:GetNetworkPing()
                if type(val) == "number" and val > 0 then
                    return val * 1000
                end
            end
            return nil
        end)
        if ok and np and np > 0 then
            return np
        end
        return nil
    end
    
    local function smoothPing(newVal)
        if not newVal or newVal <= 0 then return lastPing end
        table.insert(pingSamples, newVal)
        if #pingSamples > 5 then table.remove(pingSamples, 1) end
        local sum = 0
        for _, v in ipairs(pingSamples) do sum = sum + v end
        return math.floor(sum / #pingSamples + 0.5)
    end
    
    task.spawn(function()
        while true do
            local m = measurePing()
            if m then lastPing = smoothPing(m) end
            task.wait(2)
        end
    end)
    
    return banner
end

