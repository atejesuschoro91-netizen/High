-- ==========================================
-- NOVO RESET (Insta Reset) - MANTIDO
-- ==========================================
local resetting = false
local resetCooldown = false
local resetThread = nil
local currentCharacter = nil
local resetSuccessful = false
local stopResetSequence = false
local cameraLocked = false
local lockedCameraCFrame = nil

local RESET_CONFIG = {
    FLING_TIME = 0.35,
    FLING_POWER = 50000,
    USE_VOID = true,
    VOID_TIME = 0.5,
    TIMEOUT = 5,
    CAM_BIND = "HighHubInstaResetCam"
}

local function hide_locally(obj)
    if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("MeshPart") then
        pcall(function()
            obj.LocalTransparencyModifier = 1
        end)
    end
end

local function insta_reset()
    if resetting or resetCooldown then return end
    resetCooldown = true
    resetting = true
    
    local char = LocalPlayer.Character
    if not char or not char.Parent then 
        resetting = false
        resetCooldown = false
        return 
    end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        resetting = false
        resetCooldown = false
        return 
    end
    
    local hrp = hum.RootPart or char:FindFirstChild("HumanoidRootPart")
    local cam = workspace.CurrentCamera
    
    cameraLocked = true
    lockedCameraCFrame = cam.CFrame
    
    resetThread = task.spawn(function()
        pcall(function()
            cam.CameraType = Enum.CameraType.Scriptable
            RunService:BindToRenderStep(RESET_CONFIG.CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function()
                if cameraLocked and lockedCameraCFrame then
                    cam.CFrame = lockedCameraCFrame
                end
            end)
        end)
        
        pcall(function()
            for _, obj in ipairs(char:GetDescendants()) do 
                pcall(hide_locally, obj) 
            end
        end)
        
        local new_char
        local respawned = LocalPlayer.CharacterAdded:Connect(function(c) 
            new_char = c 
        end)
        
        local function unlock()
            pcall(function() hum.PlatformStand = false end)
            pcall(function() hum.Sit = false end)
            pcall(function() hum.AutoRotate = true end)
            pcall(function() hum.HipHeight = 0 end)
        end
        unlock()
        
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                pcall(function() 
                    obj.Anchored = false 
                    obj.CanCollide = false 
                end)
            elseif obj.Name == "SeatWeld" or obj:IsA("Weld") or obj:IsA("Motor6D") then
                pcall(function() obj:Destroy() end)
            end
        end
        
        local started = os.clock()
        local function alive_hrp()
            if hrp and hrp.Parent then return hrp end
            hrp = hum.RootPart or char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Parent then return hrp end
            return nil
        end
        
        local fling_until = os.clock() + RESET_CONFIG.FLING_TIME
        while not new_char and os.clock() < fling_until and hum.Parent do
            unlock()
            pcall(function() hum.HipHeight = 1e30 end)
            local root = alive_hrp()
            if root then
                pcall(function() 
                    root.Anchored = false 
                    root.AssemblyLinearVelocity = Vector3.new(0, RESET_CONFIG.FLING_POWER, 0)
                    root.Velocity = Vector3.new(0, RESET_CONFIG.FLING_POWER, 0)
                end)
            end
            RunService.Heartbeat:Wait()
        end
        
        if RESET_CONFIG.USE_VOID and not new_char then
            local floor = -500
            pcall(function() floor = workspace.FallenPartsDestroyHeight end)
            local void_until = os.clock() + RESET_CONFIG.VOID_TIME
            while not new_char and os.clock() < void_until do
                local root = alive_hrp()
                if not root then break end
                pcall(function() 
                    root.CFrame = CFrame.new(0, floor - 500, 0)
                    root.AssemblyLinearVelocity = Vector3.new(0, -RESET_CONFIG.FLING_POWER, 0)
                end)
                RunService.Heartbeat:Wait()
            end
        end
        
        while not new_char and os.clock() - started < RESET_CONFIG.TIMEOUT do
            if hum.Parent then
                pcall(function() 
                    hum.Health = 0 
                    hum:ChangeState(Enum.HumanoidStateType.Dead) 
                end)
            end
            if char.Parent then 
                pcall(function() char:BreakJoints() end) 
            end
            task.wait(0.05)
        end
        
        pcall(function() 
            if respawned then respawned:Disconnect() end 
        end)
        pcall(function() 
            RunService:UnbindFromRenderStep(RESET_CONFIG.CAM_BIND) 
        end)
        
        cameraLocked = false
        pcall(function()
            cam.CameraType = Enum.CameraType.Custom
            if new_char then
                local new_hum = new_char:FindFirstChildOfClass("Humanoid") or new_char:WaitForChild("Humanoid", 3)
                if new_hum then cam.CameraSubject = new_hum end
            end
        end)
        
        resetting = false
        resetCooldown = false
        resetThread = nil
        currentCharacter = nil
        stopResetSequence = false
        resetSuccessful = true
    end)
end

local function StopResetSequence()
    stopResetSequence = true
    if resetThread then
        task.cancel(resetThread)
        resetThread = nil
    end
    resetCooldown = false
    resetting = false
    currentCharacter = nil
    cameraLocked = false
    pcall(function()
        RunService:UnbindFromRenderStep(RESET_CONFIG.CAM_BIND)
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    task.delay(0.1, function()
        StopResetSequence()
        resetCooldown = false
        resetting = false
        currentCharacter = nil
        resetSuccessful = false
        stopResetSequence = false
        cameraLocked = false
    end)
end)

-- ==========================================
-- PING LAGGER (MANTIDO)
-- ==========================================
_G.LaggerOnFlash = _G.LaggerOnFlash or false
_G.LaggerPower   = _G.LaggerPower   or 50
_G.FlashSpeed    = _G.FlashSpeed    or 50

local laggerConn = nil
local laggerActive = false

local function startFlashLagger()
    if not _G.LaggerOnFlash or laggerActive then return end
    if laggerConn then 
        pcall(function() laggerConn:Disconnect() end) 
        laggerConn = nil 
    end
    
    laggerActive = true
    task.spawn(function()
        if not _G.LaggerOnFlash then 
            laggerActive = false
            return 
        end
        
        local strength = math.clamp(_G.LaggerPower / 30, 0.2, 3.0)
        pcall(function()
            settings().Network.IncomingReplicationLag = strength
        end)
        
        local duration = math.clamp(3.0 / (_G.FlashSpeed / 100 * 4 + 0.3), 0.2, 5.0)
        task.wait(duration)
        
        pcall(function() 
            settings().Network.IncomingReplicationLag = 0 
        end)
        laggerActive = false
        laggerConn = nil
    end)
end

local function stopFlashLagger()
    laggerActive = false
    if laggerConn then
        pcall(function() laggerConn:Disconnect() end)
        laggerConn = nil
    end
    pcall(function() settings().Network.IncomingReplicationLag = 0 end)
end

