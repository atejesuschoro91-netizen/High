local HeadlessVisual = {
    Enabled = false,
    Attached = false,
    AssetId = "rbxassetid://134082579",
    TargetPart = "Head",
    PartsToHide = {"Head"},
    Scale = Vector3.new(1.0, 1.0, 1.0),
    Offset = CFrame.new(0, 0, 0),
}

local function attachHeadless()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local targetPart = char:FindFirstChild(HeadlessVisual.TargetPart)
    if not targetPart then return false end
    
    -- Remove old
    local oldAsset = char:FindFirstChild("Headless_Visual")
    if oldAsset then oldAsset:Destroy() end
    
    -- Hide parts
    for _, partName in ipairs(HeadlessVisual.PartsToHide) do
        local limb = char:FindFirstChild(partName)
        if limb and limb:IsA("BasePart") then
            limb.Transparency = 1
        end
    end
    
    local success, objects = pcall(function()
        return game:GetObjects(HeadlessVisual.AssetId)
    end)
    
    if not success or not objects or #objects == 0 then
        return false
    end
    
    local assetModel = objects[1]
    assetModel.Name = "Headless_Visual"
    
    local mainMesh = assetModel:IsA("BasePart") and assetModel or assetModel:FindFirstChildWhichIsA("BasePart", true)
    if not mainMesh then return false end
    
    mainMesh.Size = mainMesh.Size * HeadlessVisual.Scale
    mainMesh.CanCollide = false
    mainMesh.CFrame = targetPart.CFrame * HeadlessVisual.Offset
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = targetPart
    weld.Part1 = mainMesh
    weld.Parent = mainMesh
    
    assetModel.Parent = char
    HeadlessVisual.Attached = true
    return true
end

local function removeHeadless()
    local char = LocalPlayer.Character
    if not char then return end
    
    local oldAsset = char:FindFirstChild("Headless_Visual")
    if oldAsset then oldAsset:Destroy() end
    
    for _, partName in ipairs(HeadlessVisual.PartsToHide) do
        local limb = char:FindFirstChild(partName)
        if limb and limb:IsA("BasePart") then
            limb.Transparency = 0
        end
    end
    
    HeadlessVisual.Attached = false
end

local function toggleHeadlessVisual(enable)
    HeadlessVisual.Enabled = enable
    if enable then
        attachHeadless()
    else
        removeHeadless()
    end
end

