    local guiLocked = false

    local lockBtn = Instance.new("TextButton")
    lockBtn.Name = "LockButton"
    lockBtn.Size = UDim2.new(0, 32, 0, 32)
    lockBtn.Position = UDim2.new(0, 8, 0, 8)
