    if not targetPlayer or not targetPlayer.Parent then return end
    local TextBox = getAdminTextBox()
    if not TextBox then return end

    local fullCmd = ";balloon " .. targetPlayer.Name
    local originalVisible = TextBox.Visible
    TextBox.Visible = false
    TextBox.Text = fullCmd
    task.wait(0.05)

    local executed = false

    if not executed and firesignal then
        pcall(function() firesignal(TextBox.FocusLost, true); executed = true end)
    end
    if not executed and getconnections then
        pcall(function()
            for _, conn in pairs(getconnections(TextBox.FocusLost)) do conn:Fire(true) end
            executed = true
        end)
    end
    if not executed then
        pcall(function()
            if firesignal then
                firesignal(TextBox.KeyDown, Enum.KeyCode.Return)
            elseif getconnections then
                for _, conn in pairs(getconnections(TextBox.KeyDown)) do conn:Fire(Enum.KeyCode.Return) end
            end
            executed = true
        end)
    end
    if not executed then
        pcall(function()
            TextBox:CaptureFocus()
            task.wait(0.0001)
            TextBox:ReleaseFocus(true)
            executed = true
        end)
    end

    task.wait(0.05)
    TextBox.Text = ""
    TextBox.Visible = originalVisible
end

-- Heartbeat para Auto Balloon (executado a cada 0.2s)
local balloonHeartbeatConn
balloonHeartbeatConn = RunService.Heartbeat:Connect(function()
    if not KayBalloon.Enabled then return end
    local now = tick()

    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local uid = p.UserId
        
        -- Verifica se está sendo roubado (StealingPlayer)
        local isStealing = p:GetAttribute("StealingPlayer") == true
        if not isStealing then
            KayBalloon.WallActive[uid] = nil
            KayBalloon.Active[uid] = nil
            continue
        end

        KayBalloon.WallActive[uid] = true

        local character = p.Character
        if not character then continue end
        local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if not rootPart then continue end

        local humanoid  = character:FindFirstChildOfClass("Humanoid")
        local hipHeight = humanoid and humanoid.HipHeight or 2
        local rootPos   = rootPart.Position
        local feetPos   = rootPos - Vector3.new(0, hipHeight + 1, 0)

        local backpack = p:FindFirstChildOfClass("Backpack")
        local isGiant  = backpack and backpack:FindFirstChild("Giant Potion") ~= nil

        local inZone = isNearAnyWall(rootPos) or isNearAnyWall(feetPos)
        
        -- Se for Giant, verifica também posição simulada
        if not inZone and isGiant then
            for _, w in ipairs(_wallCache) do
                local dx  = w.px - rootPos.X
                local dz  = w.pz - rootPos.Z
                local dot = dx * w.nx + dz * w.nz
                if math.abs(dot) > 30 then continue end
                local simPos = rootPos + Vector3.new(w.nx * 15, 0, w.nz * 15)
                if isNearAnyWall(simPos) then inZone = true; break end
            end
        end

        if not inZone then
            KayBalloon.Active[uid] = nil
            continue
        end

        if KayBalloon.Active[uid] then continue end
        if now - (KayBalloon.Cooldown[uid] or 0) < KayBalloon.CooldownTime then continue end

        KayBalloon.Active[uid] = true
        KayBalloon.Cooldown[uid] = now

        task.spawn(function() triggerBalloonOnTarget(p) end)
    end
end)
