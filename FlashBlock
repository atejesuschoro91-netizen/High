-- CLEANUP ON SCRIPT STOP
-- ==========================================
local function cleanup()
    thisScriptStopped = true
    for _, conn in ipairs(ActiveConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ActiveConnections = {}
    stopFlashLagger()
    stopAutoResetTiny()
    stopAutoResetJail()
    StopResetSequence()
    clearTpPathVisual()
    clearBaseESP()
    clearBackpackESP()
    clearAPESP()
    KayBalloon.Active = {}
    KayBalloon.WallActive = {}
   
    
    -- Cleanup visuais
    removeHeadless()
    removeKorbloxRightLeg()
end

game:GetService("ScriptContext"):GetScriptsAddedSignal():Connect(function()
    if thisScriptStopped then return end
    local errorHandler = function(err)
        warn("[HIGH HUB] Error:", err)
        if string.find(err, "Script requires") then
            cleanup()
        end
    end
    xpcall(function() end, errorHandler)
end)
